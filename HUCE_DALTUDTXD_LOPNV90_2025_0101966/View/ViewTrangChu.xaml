<Window x:Class="TinhToanCoc.View.ViewTrangChu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TinhToanCoc.View" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="ViewTrangChu" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/menuButton.xaml"/>
                <ResourceDictionary Source="../Resources/Styles/ImageStyle.xaml"/>
                <ResourceDictionary Source="../Resources/Styles/menuItemButton.xaml"/>
                <ResourceDictionary Source="../Resources/Styles/signInButtonIcon.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Background="{StaticResource ChuDao3}" Height="35" >
        </Border>
        <Border Grid.RowSpan="2" Grid.Row="1" Background="{StaticResource ChuDao2}" CornerRadius="20" Margin="5"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 20 0">
            <Image Width="30" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0 100 0 0">
            <Button x:Name="btnKhaiBaoCoc" Style="{StaticResource menuButton}" Click="btnKhaiBaoCoc_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Style="{StaticResource ImageStyle}"/>
                    <TextBlock Text="Khai Báo Cọc"></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnTinhToanCoc" Style="{StaticResource menuButton}" Click="btnTinhToanCoc_Click">
                <StackPanel Orientation="Horizontal">
                    <Image  Style="{StaticResource ImageStyle}"/>
                    <TextBlock Text="Tính Toán Cọc"></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnTruDiaChat" Style="{StaticResource menuButton}" Click="btnTruDiaChat_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Style="{StaticResource ImageStyle}"/>
                    <TextBlock Text="Trụ Địa Chất"></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnTinhToanDaiCoc" Style="{StaticResource menuButton}" Click="btnTinhToanDaiCoc_Click">
                <StackPanel Orientation="Horizontal">
                    <Image  Style="{StaticResource ImageStyle}"/>
                    <TextBlock Text="Tính Đài Cọc"></TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
        <Button x:Name="btnLogout" Grid.Row="2" Style="{StaticResource menuButton}" VerticalAlignment="Bottom"
        Margin="15 0 15 20">
            <StackPanel Orientation="Horizontal">
                <Image Source="/icon/logout.png" Style="{StaticResource ImageStyle}"/>
                <TextBlock Text="Đăng xuất"></TextBlock>
            </StackPanel>
        </Button>
        <Frame x:Name="frame_Body" Grid.Column="1" Grid.Row="1"/>
    </Grid>
</Window>
